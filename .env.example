# C++ backend runtime
APP_ENV=development
HOST=0.0.0.0
PORT=8000
THREADS=4
BASE_DIR=.
DOCUMENT_ROOT=.

# Public URL used in invitation links delivered by email/SMS
PUBLIC_WEB_BASE_URL=http://127.0.0.1:8000

# Referral reward credits granted to the referrer after a referred user activates a paid personal plan.
REFERRAL_REWARD_CREDITS=10

# Logging
LOG_LEVEL=DEBUG
LOG_DIR=logs/backend
LOG_FILE_BASENAME=exam-online-cpp
LOG_FILE_SIZE=100000000
LOG_MAX_FILES=10

# WeChat (optional)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_BASE_URL=

# Invitation delivery providers
# Keep stub/stub for local development. Switch to real providers in production.

# SMS provider: stub | twilio
SMS_PROVIDER=stub
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
SMS_API_BASE_URL=https://api.twilio.com

# Email provider: stub | resend
EMAIL_PROVIDER=stub
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Exam Online
EMAIL_API_BASE_URL=https://api.resend.com
