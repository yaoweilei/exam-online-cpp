{
  "assistant" : 
  {
    "description" : "助教、班主任、教务或课程顾问的基础角色，通过权限模板区分职责。",
    "id" : "assistant",
    "name" : "教学运营",
    "permissions" : 
    [
      "assignment.review",
      "assignment.remind",
      "student.profile.view",
      "student.profile.edit",
      "student.followup.edit",
      "learning_record.comment",
      "course_package.view"
    ]
  },
  "contentAdmin" : 
  {
    "description" : "维护平台试卷、音频、图片、答案、解析和发布质量。",
    "id" : "contentAdmin",
    "name" : "内容管理员",
    "permissions" : 
    [
      "content.exam.edit",
      "content.audio.manage",
      "content.image.manage",
      "content.answer.edit",
      "content.analysis.edit",
      "content.publish",
      "content.audit.view"
    ]
  },
  "guest" : 
  {
    "description" : "未登录状态，可浏览公开内容和进入登录注册。",
    "id" : "guest",
    "name" : "访客",
    "permissions" : 
    [
      "exam.public.view"
    ]
  },
  "orgAdmin" : 
  {
    "description" : "管理机构成员、学习组、课程包、套餐席位、机构看板和审计。",
    "id" : "orgAdmin",
    "name" : "机构管理员",
    "permissions" : 
    [
      "organization.member.manage",
      "learning_group.manage",
      "course_package.manage",
      "lesson.booking.manage",
      "organization.dashboard.view",
      "organization.billing.manage",
      "audit.view"
    ]
  },
  "student" : 
  {
    "description" : "个人用户或机构学员，可做题、提交作业、查看自己的学习报告。",
    "id" : "student",
    "name" : "学员",
    "permissions" : 
    [
      "exam.practice",
      "answer.submit",
      "analysis.view",
      "assignment.submit",
      "report.view.self",
      "learning_record.view.self"
    ]
  },
  "superAdmin" : 
  {
    "description" : "平台最高权限，仅用于平台运营和技术管理。",
    "id" : "superAdmin",
    "name" : "平台超级管理员",
    "permissions" : 
    [
      "*"
    ]
  },
  "teacher" : 
  {
    "description" : "负责学习组教学、作业、批改、课后反馈和备课。",
    "id" : "teacher",
    "name" : "老师",
    "permissions" : 
    [
      "assignment.create",
      "assignment.review",
      "assignment.remind",
      "gradebook.view",
      "student.profile.view",
      "student.profile.edit",
      "lesson_prep.create",
      "lesson_prep.export",
      "learning_record.feedback.edit"
    ]
  }
