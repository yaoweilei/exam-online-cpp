{
    "assistant":  {
                      "description":  "协助教师处理题目初稿与资源整理，不能最终发布。",
                      "id":  "assistant",
                      "name":  "助理",
                      "permissions":  [
                                          "editDraft",
                                          "attachResource"
                                      ]
                  },
    "academic":  {
                     "description":  "管理教学安排与试卷调度，可发起与跟踪审核流程。",
                     "id":  "academic",
                     "name":  "教务",
                     "permissions":  [
                                         "scheduleExam",
                                         "reviewExam",
                                         "publishExam"
                                     ]
                 },
    "student":  {
                    "description":  "参加考试与查看结果，无管理权限。",
                    "id":  "student",
                    "name":  "学生",
                    "permissions":  [
                                        "takeExam",
                                        "viewResult"
                                    ]
                },
    "guest":  {
                  "description":  "Guest",
                  "id":  "guest",
                  "name":  "guest",
                  "permissions":  [
                                      "view_exams",
                                      "submit_answers"
                                  ]
              },
    "teacher":  {
                    "description":  "编写与更新试卷，需要审核后才能发布。",
                    "id":  "teacher",
                    "name":  "教师",
                    "permissions":  [
                                        "editExam",
                                        "submitForReview"
                                    ]
                },
    "superAdmin":  {
                       "description":  "拥有系统最高权限，包含所有管理与审核能力。",
                       "id":  "superAdmin",
                       "name":  "超级管理员",
                       "permissions":  [
                                           "manageSystem",
                                           "manageUsers",
                                           "manageRoles",
                                           "reviewExam",
                                           "editExam",
                                           "publishExam"
                                       ]
                   },
    "systemAdmin":  {
                        "description":  "维护系统配置与资源，具备用户与试卷的常规管理权限。",
                        "id":  "systemAdmin",
                        "name":  "系统管理员",
                        "permissions":  [
                                            "manageUsers",
                                            "reviewExam",
                                            "editExam",
                                            "publishExam"
                                        ]
                    }
}
